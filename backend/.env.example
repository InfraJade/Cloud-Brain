# ─────────────────────────────────────────────────────────────────────────────
# CLOUD BRAIN backend — copy to backend/.env and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string used to sign login tokens. Change it.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Who can sign in: "email:password:Full Name:role" entries separated by ";".
# role = admin (can also de-provision from the Cloud page) | operator
CLOUD_BRAIN_USERS=admin@jadeglobal.com:Admin@123:Platform Admin:admin;ops@jadeglobal.com:Ops@123:Cloud Operator:operator

# Browser origins allowed to call this API (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AWS Cloud Brain API (API Gateway) — see the backend spec (BACKEND-API.md) ─
CHATOPS_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com
# Step Functions routes (asynchronous: accepted immediately, done minutes later).
CHATOPS_PROVISION_PATH=/provision
CHATOPS_DELETE_PATH=/resource
# Lambda routes. A route that isn't deployed yet shows sample data in the UI.
CHATOPS_AGENT_PATH=/agent
CHATOPS_AGENT_API_URL=
CHATOPS_INVENTORY_PATH=/inventory
CHATOPS_COST_CURRENT_PATH=/cost/current
CHATOPS_COST_FORECAST_PATH=/cost/forecast
CHATOPS_COST_REPORT_PATH=/cost/report
# Optional; sent as the x-api-key header if your API Gateway requires one.
CHATOPS_API_KEY=
# Timeouts in seconds (API Gateway itself cuts requests at 30 s).
CHATOPS_REQUEST_TIMEOUT=25
CHATOPS_AGENT_TIMEOUT=35
CHATOPS_INSIGHTS_TIMEOUT=35

# Environments the Provision form offers (comma-separated). The workflow accepts dev, qa
# and stage, but only dev exists in the Terraform repo today — widen this when it does.
CHATOPS_ALLOWED_ENVS=dev

# ── Resource registry: direct DynamoDB reads ─────────────────────────────────
# Used for the Resources page and request tracking (the API's own GET /status can't
# return data). Two credential modes (static keys win if both are set):
#   - CHATOPS_AWS_ACCESS_KEY_ID / CHATOPS_AWS_SECRET_ACCESS_KEY: a static IAM user's keys.
#   - CHATOPS_AWS_ROLE_ARN: assume this role (base creds from the normal boto3 chain or
#     CHATOPS_AWS_PROFILE; that identity must be trusted by the role).
# Needs dynamodb:Scan, dynamodb:Query (on the index) and dynamodb:GetItem.
AWS_REGION=us-east-1
CHATOPS_AWS_ACCESS_KEY_ID=
CHATOPS_AWS_SECRET_ACCESS_KEY=
CHATOPS_AWS_ROLE_ARN=
CHATOPS_AWS_ROLE_SESSION_NAME=cloud-brain-reader
CHATOPS_AWS_EXTERNAL_ID=
CHATOPS_AWS_PROFILE=
CHATOPS_DYNAMODB_TABLE=aws-ops-resources
CHATOPS_DYNAMODB_REQUEST_INDEX=request_id-index
